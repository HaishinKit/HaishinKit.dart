require 'fileutils'
require 'tmpdir'

desc "[CI] Review PullRequest."
lane :review do
  Dir.chdir(File.expand_path('..', __dir__)) do
    sh('flutter pub get')
    sh('dart run build_runner build')
    sh('flutter analyze')
    sh('flutter test')
    Dir.chdir('example') do
      sh('flutter pub get')
      sh('flutter analyze')
      sh('flutter test')
    end
  end
end

desc "[CI] Build the Android example."
lane :android_check do
  Dir.chdir(File.expand_path('../example', __dir__)) do
    sh('flutter build apk --debug')
  end
end

# dartdoc preserves the README's relative image URLs, so publish their assets too.
def copy_example_screenshots(source_root, destination)
  source = File.join(source_root, 'example', 'design', 'screenshots')
  target = File.join(destination, 'example', 'design')
  FileUtils.mkdir_p(target)
  FileUtils.cp_r(source, target)
end

desc 'Creates documents.'
lane :document do |options|
  version = options[:version].to_s
  UI.user_error!('A valid version is required') unless version.match?(/\A[a-zA-Z0-9][a-zA-Z0-9.+-]*\z/)
  source = File.expand_path(options[:source_directory] || '..', Dir.pwd)
  Dir.chdir(source) { sh('flutter', 'pub', 'get') }

  Dir.mktmpdir('haishinkit-dart-documentation-') do |directory|
    repository = File.join(directory, 'site')
    sh('git', 'clone', '--depth', '1', 'git@github.com:HaishinKit/docs.haishinkit.com.git', repository)
    %w[latest].push(version).uniq.each do |destination|
      target = File.join(repository, 'dart', destination)
      FileUtils.rm_rf(target)
      sh('dart', 'doc', source, '-o', target)
      copy_example_screenshots(source, target)
    end
    Dir.chdir(repository) do
      if Helper.is_ci?
        sh('git', 'config', 'user.email', 'action@github.com')
        sh('git', 'config', 'user.name', 'GitHub Action')
      end
      sh('git', 'add', 'dart')
      if system('git', 'diff', '--cached', '--quiet')
        UI.message('Documentation is already up to date')
      else
        sh('git', 'commit', '-m', "Add HaishinKit.dart #{version}")
        sh('git', 'push', 'origin', 'main')
      end
    end
  end
end
